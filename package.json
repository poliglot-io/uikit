  "scripts": {
    "build": "npm run build:css && tsc && npm run build:stories && cp src/storybook/tokens.css dist/storybook/tokens.css",
    "build:stories": "tsc -p tsconfig.stories.json --noCheck",
    "build:css": "node scripts/build-css.js",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "surface:gen": "tsx scripts/gen-component-surface.ts",
    "surface:check": "tsx scripts/gen-component-surface.ts --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
